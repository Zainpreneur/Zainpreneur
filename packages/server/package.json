{
  "name": "@zainpreneur/server",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/db/prisma/seed.ts",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@zainpreneur/shared": "workspace:*",
    "@prisma/client": "^6.6.0",
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0",
    "zod": "^3.24.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "dotenv": "^16.4.0",
    "@hono/swagger-ui": "^0.5.0",
    "@hono/zod-openapi": "^0.18.0"
  },
  "devDependencies": {
    "prisma": "^6.6.0",
    "tsx": "^4.19.0",
    "vitest": "^3.1.0",
    "@types/supertest": "^6.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.10.0",
    "typescript": "~5.7.0"
  }
}
