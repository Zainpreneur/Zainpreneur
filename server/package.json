{
  "name": "@zainpreneur/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Zainpreneur Business Portfolio API.",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch --experimental-sqlite src/index.ts",
    "start": "tsx --experimental-sqlite src/index.ts",
    "seed": "tsx --experimental-sqlite src/seed.ts",
    "db:reset": "tsx --experimental-sqlite src/scripts/reset.ts",
    "db:seed": "tsx --experimental-sqlite src/scripts/reset.ts --seed",
    "test": "tsx --experimental-sqlite --test test/*.test.ts"
  },
  "dependencies": {
    "@zainpreneur/shared": "*",
    "express": "4.22.3",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/express": "file:../vendor/types-express-4.17.25.tgz",
    "@types/node": "26.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}