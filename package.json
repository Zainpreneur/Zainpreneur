{
  "name": "zainpreneur-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @zainpreneur/shared build && pnpm --filter @zainpreneur/server build && pnpm --filter @zainpreneur/web build",
    "start": "pnpm --filter @zainpreneur/server start",
    "dev": "pnpm --filter @zainpreneur/server dev",
    "test": "pnpm --filter @zainpreneur/server test",
    "db:migrate": "pnpm --filter @zainpreneur/server db:migrate",
    "db:seed": "pnpm --filter @zainpreneur/server db:seed",
    "install": "pnpm install --frozen-lockfile",
    "prepare": "pnpm install --frozen-lockfile"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "~5.7.0"
  },
  "dependencies": {
    "express": "^4.19.2"
  }
}